<?xml version="1.0"?>
<!--
  person_follow.xml
  ═════════════════
  Custom Nav2 Behavior Tree for person-following with dynamic target tracking.

  Design rationale (person-following vs. standard navigation):
  ──────────────────────────────────────────────────────────────
  • 5 Hz replanning rate (vs. 1-2 Hz standard) — the tracked person moves
    continuously; the path must be recomputed frequently to stay relevant.
  • Outer retries = 10 — the person may lead through tricky terrain or tight
    passages; generous retries avoid premature goal failure.
  • Minimal recovery sequence — unlike static-goal navigation, full 360° spins
    and long waits lose visual contact. Only enough recovery to dislodge the
    robot from a local dead-end, then retry the path.
  • Graduated recovery (RoundRobin cycles through each on successive failures):
      1. Clear local costmap — person moved, stale obstacles in local map
      2. BackUp 0.15 m       — back away from obstacle contact
      3. Spin 0.5 rad (~30°)— small reorient, preserve facing direction
         (never 360°; that wastes time and risks losing the target)
      4. → cycles back to #1
  • GoalUpdated in ReactiveFallback — if fusion_node sends a new goal while
    recovering, abort recovery immediately and re-navigate.

  Activation:
  ────────────
  Set in nav2_params.yaml:
    default_nav_to_pose_bt_xml: "replace_with_pkg_share/config/bt/person_follow.xml"

  Nav2 BT node reference:
    https://navigation.ros.org/behavior_trees/trees/nav2_bt_navigator_navigate_to_pose.html
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <!--
      Outer retry wrapper: up to 10 full navigate+recover cycles.
      The high retry count accounts for a dynamic target that may lead
      through challenging terrain. If all 10 fail → NavigateToPose
      returns FAILED and fusion_node re-sends the goal.
    -->
    <RecoveryNode number_of_retries="10" name="NavigateRecovery">

      <!-- ── Navigation pipeline ────────────────────────────────────────── -->
      <PipelineSequence name="NavigateWithReplanning">

        <!--
          Recompute the global path at 5 Hz while following.
          Person-following needs aggressive replanning — the target is
          moving, unlike a static goal.

          Wrapped in RecoveryNode: on planner failure, clear the global
          costmap once then retry (the person may have moved behind an
          obstacle that was blocking the planner).
        -->
        <RateController hz="5.0">
          <RecoveryNode number_of_retries="1" name="ComputePathRecovery">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearEntireCostmap
              name="ClearGlobalCostmap-Replanning"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <!--
          Follow the computed path.
          On controller failure, clear the local costmap once then retry
          (the person's movement near the robot may create transient obstacles
          in the local costmap).
        -->
        <RecoveryNode number_of_retries="1" name="FollowPathRecovery">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap
            name="ClearLocalCostmap-Following"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>

      </PipelineSequence>

      <!-- ── Recovery fallback (goal update check + graduated actions) ──── -->
      <!--
        ReactiveFallback: checks GoalUpdated on every tick.
        If fusion_node publishes a new goal while recovering, abort recovery
        and re-enter navigation with the updated target position.
      -->
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>

        <!--
          RoundRobin: each failure cycles to the NEXT recovery action.
          This produces a graduated response:
            Failure 1 → ClearLocalCostmap
            Failure 2 → BackUp 0.15 m
            Failure 3 → Spin 0.5 rad (~30°)
            Failure 4 → cycles back to ClearLocalCostmap

          Designed for person-following minimalism: never a full 360° spin
          or long wait that could lose visual contact with the tracked person.
        -->
        <RoundRobin name="RecoveryActions">

          <!-- Step 1: clear only the local costmap.
               Most failures are caused by the person's movement leaving stale
               obstacles in the local map. Lightest recovery, try first. -->
          <ClearEntireCostmap
            name="ClearLocal"
            service_name="local_costmap/clear_entirely_local_costmap"/>

          <!-- Step 2: back away 0.15 m.
               If clearing wasn't enough, the robot may be pressed against an
               obstacle. Short backup to create space. -->
          <BackUp backup_dist="0.15" backup_speed="0.05"/>

          <!-- Step 3: small reorient 0.5 rad (~30°).
               A tiny spin to acquire new laser data and find an escape path.
               Never 360° — full rotation wastes time and risks losing the
               visual track on the person. -->
          <Spin spin_dist="0.50"/>

        </RoundRobin>
      </ReactiveFallback>

    </RecoveryNode>
  </BehaviorTree>
</root>
