<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meister_web_nav</name>
  <version>0.1.0</version>
  <description>Local web UI for sending Nav2 waypoints — displays the live map and lets the user place multiple markers to send as a waypoint tour.</description>
  <maintainer email="s25089@tokyo.kosen-ac.jp">so</maintainer>
  <license>MIT</license>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>rclcpp_action</depend>
  <depend>ament_index_cpp</depend>
  <depend>libopencv-dev</depend>
  <depend>nlohmann-json3-dev</depend>
  <depend>libcpp-httplib-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
