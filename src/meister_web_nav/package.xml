<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meister_web_nav</name>
  <version>0.1.0</version>
  <description>Local web UI for sending Nav2 waypoints — displays the live map and lets the user place multiple markers to send as a waypoint tour.</description>
  <maintainer email="s25089@tokyo.kosen-ac.jp">so</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_simple_commander</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
