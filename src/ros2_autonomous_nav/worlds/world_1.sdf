<?xml version="1.0"?>
<sdf version="1.10">
  <world name="world_1">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- House/Office Layout -->
    <!-- Outer Walls (10x10m) -->
    <model name="outer_n"><static>true</static><pose>0 5 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry><material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material></visual></link></model>
    <model name="outer_s"><static>true</static><pose>0 -5 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>10 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>10 0.2 2</size></box></geometry><material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material></visual></link></model>
    <model name="outer_w"><static>true</static><pose>-5 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 10 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 2</size></box></geometry><material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material></visual></link></model>
    <model name="outer_e"><static>true</static><pose>5 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 10 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 10 2</size></box></geometry><material><ambient>0.7 0.7 0.8 1</ambient><diffuse>0.7 0.7 0.8 1</diffuse></material></visual></link></model>

    <!-- Internal Rooms -->
    <!-- Room 1 Wall -->
    <model name="in_1"><static>true</static><pose>-2 2 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>6 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>6 0.2 2</size></box></geometry></visual></link></model>
    <!-- Room 2 Wall (Hallway) -->
    <model name="in_2"><static>true</static><pose>1 -2 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 6 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 6 2</size></box></geometry></visual></link></model>
    <!-- Room 3 Wall -->
    <model name="in_3"><static>true</static><pose>-3 -2 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4 0.2 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4 0.2 2</size></box></geometry></visual></link></model>

    <!-- Furniture / Obstacles -->
    <model name="desk_1"><static>true</static><pose>-3 3.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 0.8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.8 1</size></box></geometry><material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual></link></model>
    <model name="desk_2"><static>true</static><pose>3 3.5 0.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 0.8 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 0.8 1</size></box></geometry><material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual></link></model>
    <model name="trash_bin"><static>true</static><pose>4 -4 0.3 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></visual></link></model>

  </world>
</sdf>
