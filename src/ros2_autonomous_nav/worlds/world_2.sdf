<?xml version="1.0"?>
<sdf version="1.10">
  <world name="world_2">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Warehouse Layout -->
    <!-- Large Outer Walls (20x20m) -->
    <model name="outer_n"><static>true</static><pose>0 10 2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>20 0.2 4</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.2 4</size></box></geometry></visual></link></model>
    <model name="outer_s"><static>true</static><pose>0 -10 2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>20 0.2 4</size></box></geometry></collision><visual name="v"><geometry><box><size>20 0.2 4</size></box></geometry></visual></link></model>
    <model name="outer_w"><static>true</static><pose>-10 0 2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 20 4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 20 4</size></box></geometry></visual></link></model>
    <model name="outer_e"><static>true</static><pose>10 0 2 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.2 20 4</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 20 4</size></box></geometry></visual></link></model>

    <!-- Warehouse Shelves (Aisles) -->
    <model name="shelf_1"><static>true</static><pose>-5 0 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 12 3</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 12 3</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual></link></model>
    <model name="shelf_2"><static>true</static><pose>0 0 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 12 3</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 12 3</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual></link></model>
    <model name="shelf_3"><static>true</static><pose>5 0 1.5 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.5 12 3</size></box></geometry></collision><visual name="v"><geometry><box><size>1.5 12 3</size></box></geometry><material><ambient>0.8 0.5 0.2 1</ambient><diffuse>0.8 0.5 0.2 1</diffuse></material></visual></link></model>

    <!-- Scattered Crates -->
    <model name="crate_1"><static>true</static><pose>-2.5 5 0.5 0 0 0.4</pose><link name="link"><collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1 1 1</size></box></geometry></visual></link></model>
    <model name="crate_2"><static>true</static><pose>2.5 -5 0.5 0 0 -0.2</pose><link name="link"><collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1 1 1</size></box></geometry></visual></link></model>
    <model name="crate_3"><static>true</static><pose>7.5 2 0.5 0 0 0.1</pose><link name="link"><collision name="c"><geometry><box><size>1 1 1</size></box></geometry></collision><visual name="v"><geometry><box><size>1 1 1</size></box></geometry></visual></link></model>

  </world>
</sdf>
