<?xml version="1.0"?>
<!--
  model.sdf — Meister Robot SDF model for Gazebo Harmonic

  Auto-generated from URDF. Model origin = base_link frame.
  Spawn with:
    <include>
      <uri>model://meister_robot</uri>
      <pose>1.5 1.0 0.3 0 0 0</pose>
    </include>

  Requires GZ_SIM_RESOURCE_PATH to include parent of meister_robot/.
-->
<sdf version="1.8">
  <model name="meister_robot">
    <pose>0 0 0 0 0 0</pose>

    <!-- ── base_footprint ──────────────────────────────────────────── -->
    <link name="base_footprint">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.01</mass>
        <inertia>
          <ixx>7.508e-05</ixx>
          <iyy>0.0001334</iyy>
          <izz>0.0002083</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.4 0.3 0.01</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.4 0.3 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.0 0.0 1.0 0.3</ambient>
          <diffuse>0.0 0.0 1.0 0.3</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── base_link (empty structural link) ───────────────────────── -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-06</ixx>
          <iyy>1e-06</iyy>
          <izz>1e-06</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
    </link>

    <!-- ── chassis (main body) ─────────────────────────────────────── -->
    <link name="chassis">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0.06 0 0 0</pose>
        <mass>2.0</mass>
        <inertia>
          <ixx>0.0174</ixx>
          <iyy>0.02907</iyy>
          <izz>0.04167</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.3 0.12</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.06 0 0 0</pose>
        <geometry>
          <box>
            <size>0.4 0.3 0.12</size>
          </box>
        </geometry>
        <material>
          <ambient>0.25 0.45 0.75 1.0</ambient>
          <diffuse>0.25 0.45 0.75 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── Front-Left Wheel ────────────────────────────────────────── -->
    <link name="lf_wheel">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00011375</ixx>
          <iyy>0.00011375</iyy>
          <izz>0.0001875</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── Front-Right Wheel ───────────────────────────────────────── -->
    <link name="rf_wheel">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00011375</ixx>
          <iyy>0.00011375</iyy>
          <izz>0.0001875</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── Rear-Left Wheel ─────────────────────────────────────────── -->
    <link name="lr_wheel">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00011375</ixx>
          <iyy>0.00011375</iyy>
          <izz>0.0001875</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── Rear-Right Wheel ────────────────────────────────────────── -->
    <link name="rr_wheel">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.00011375</ixx>
          <iyy>0.00011375</iyy>
          <izz>0.0001875</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1.0</ambient>
          <diffuse>0.15 0.15 0.15 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- ── Laser (2D LiDAR) ────────────────────────────────────────── -->
    <link name="laser_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.05</mass>
        <inertia>
          <ixx>3.792e-05</ixx>
          <iyy>3.792e-05</iyy>
          <izz>6.25e-05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.04</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.13 0.13 0.13 1.0</ambient>
          <diffuse>0.13 0.13 0.13 1.0</diffuse>
        </material>
      </visual>
      <!-- GPU LiDAR sensor -->
      <sensor name="laser_link_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.3</min>
            <max>12.0</max>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ══════════════════════════════════════════════════════════════
         JOINTS
         ══════════════════════════════════════════════════════════════ -->

    <!-- base_footprint sitting on ground, below base_link -->
    <joint name="base_footprint_joint" type="fixed">
      <parent>base_link</parent>
      <child>base_footprint</child>
      <pose>0 0 -0.05 0 0 0</pose>
    </joint>

    <!-- Chassis rigidly attached to base_link -->
    <joint name="chassis_joint" type="fixed">
      <parent>base_link</parent>
      <child>chassis</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <!-- Front-Left Wheel: continuous rotation around Z in joint frame
         (joint frame rotated -90° around X so Z→Y in robot frame) -->
    <joint name="lf_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>lf_wheel</child>
      <pose>0.15 0.1 0 -1.5708 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Front-Right Wheel -->
    <joint name="rf_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rf_wheel</child>
      <pose>0.15 -0.1 0 1.5708 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <!-- Rear-Left Wheel -->
    <joint name="lr_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>lr_wheel</child>
      <pose>-0.15 0.1 0 -1.5708 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Rear-Right Wheel -->
    <joint name="rr_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>rr_wheel</child>
      <pose>-0.15 -0.1 0 1.5708 0 0</pose>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <!-- Laser fixed on top of base_link -->
    <joint name="laser_link_joint" type="fixed">
      <parent>base_link</parent>
      <child>laser_link</child>
      <pose>0 0 0.2 0 0 0</pose>
    </joint>

    <!-- ══════════════════════════════════════════════════════════════
         GAZEBO PLUGINS
         ══════════════════════════════════════════════════════════════ -->

    <!-- Joint state publisher (publishes joint_states topic) -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>lf_wheel_joint</joint_name>
      <joint_name>rf_wheel_joint</joint_name>
      <joint_name>lr_wheel_joint</joint_name>
      <joint_name>rr_wheel_joint</joint_name>
    </plugin>

    <!-- MecanumDrive plugin (reads /cmd_vel directly) -->
    <plugin filename="libgz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
      <front_left_joint>lf_wheel_joint</front_left_joint>
      <front_right_joint>rf_wheel_joint</front_right_joint>
      <back_left_joint>lr_wheel_joint</back_left_joint>
      <back_right_joint>rr_wheel_joint</back_right_joint>
      <wheel_separation>0.2</wheel_separation>
      <wheelbase>0.3</wheelbase>
      <wheel_radius>0.05</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <tf_topic>/tf</tf_topic>
    </plugin>

  </model>
</sdf>
