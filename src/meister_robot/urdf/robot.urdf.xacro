<?xml version="1.0"?>
<robot name="meister_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gazebo="http://gazebo.apache.org/xmlns/gazebo">

  <!-- ────────────────────────────────────
       Arguments
       ──────────────────────────────────── -->
  <xacro:arg name="namespace" default=""/>
  <xacro:property name="ns" value="$(arg namespace)"/>

  <!-- ────────────────────────────────────
       Includes
       ──────────────────────────────────── -->
  <xacro:include filename="mecanum_wheel.xacro"/>
  <xacro:include filename="lidar.xacro"/>
  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ────────────────────────────────────
       Robot constants
       ──────────────────────────────────── -->
  <!-- Body dimensions -->
  <xacro:property name="body_length" value="0.4"/>
  <xacro:property name="body_width"  value="0.3"/>
  <xacro:property name="body_height" value="0.12"/>
  <xacro:property name="body_mass"   value="2.0"/>

  <!-- Wheel geometry -->
  <xacro:property name="wheel_radius" value="0.05"/>

  <!-- Kinematic layout: wheel positions from robot centre (m) -->
  <!-- wheelbase (front-rear axle distance) = 0.30 m → half = 0.15 -->
  <xacro:property name="lx" value="0.15"/>
  <!-- track   (left-right wheel distance)  = 0.20 m → half = 0.10 -->
  <xacro:property name="ly" value="0.10"/>
  <!-- L = lx + ly ≈ 0.25 m (used by mecanum_controller.py) -->
  <xacro:property name="L"  value="${lx + ly}"/>

  <!-- ────────────────────────────────────
       Links: base_footprint → base_link
       ──────────────────────────────────── -->
  <link name="base_footprint">
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} 0.01"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} 0.01"/>
      </geometry>
      <material name="footprint_material">
        <color rgba="0.0 0.0 1.0 0.3"/>
      </material>
    </visual>
  </link>

  <link name="base_link"/>

  <!-- base_footprint sits on the ground (z=0 in world);
       base_link is wheel_radius above ground so wheel axes are at z=0 on base_link -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 -${wheel_radius}"/>
  </joint>

  <!-- ────────────────────────────────────
       Chassis body
       ──────────────────────────────────── -->
  <link name="chassis">
    <visual>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="chassis_material">
        <color rgba="0.25 0.45 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${body_height/2}"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="${body_mass}" x="${body_length}" y="${body_width}" z="${body_height}">
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- ────────────────────────────────────
       Mecanum wheels
       ──────────────────────────────────── -->
  <xacro:mecanum_wheel name="lf" x="${ lx}" y="${ ly}" z="0"/>
  <xacro:mecanum_wheel name="rf" x="${ lx}" y="${-ly}" z="0"/>
  <xacro:mecanum_wheel name="lr" x="${-lx}" y="${ ly}" z="0"/>
  <xacro:mecanum_wheel name="rr" x="${-lx}" y="${-ly}" z="0"/>

  <!-- ────────────────────────────────────
       2D LiDAR
       ──────────────────────────────────── -->
  <xacro:lidar name="laser_link" x="0" y="0" z="0.2" roll="0" pitch="0" yaw="0"/>

  <!-- ────────────────────────────────────
       Gazebo simulation plugins
       ──────────────────────────────────── -->

  <!-- Friction properties -->
  <gazebo reference="chassis">
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
  </gazebo>

  <gazebo reference="lf_wheel">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>
  <gazebo reference="rf_wheel">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>
  <gazebo reference="lr_wheel">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>
  <gazebo reference="rr_wheel">
    <mu1>0.4</mu1>
    <mu2>0.4</mu2>
  </gazebo>

  <!-- Joint state publisher (publishes joint_states topic) -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
      <joint_name>lf_wheel_joint</joint_name>
      <joint_name>rf_wheel_joint</joint_name>
      <joint_name>lr_wheel_joint</joint_name>
      <joint_name>rr_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- MecanumDrive plugin (reads /cmd_vel directly; bypass for custom controller)
       Comment out the block below when using mecanum_controller.py + ros_gz_bridge
       joint-level bridging, and uncomment the DiffDrive plugin block instead. -->
  <gazebo>
    <plugin filename="libgz-sim-mecanum-drive-system"
            name="gz::sim::systems::MecanumDrive">
      <front_left_joint>lf_wheel_joint</front_left_joint>
      <front_right_joint>rf_wheel_joint</front_right_joint>
      <back_left_joint>lr_wheel_joint</back_left_joint>
      <back_right_joint>rr_wheel_joint</back_right_joint>
      <wheel_separation>${2 * ly}</wheel_separation>
      <wheelbase>${2 * lx}</wheelbase>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>50</odom_publish_frequency>
      <topic>${ns + '/cmd_vel' if ns else 'cmd_vel'}</topic>
      <min_acceleration>-3.0</min_acceleration>
      <max_acceleration>3.0</max_acceleration>
      <odom_topic>${ns + '/odom' if ns else 'odom'}</odom_topic>
      <frame_id>${ns + '/odom' if ns else 'odom'}</frame_id>
      <child_frame_id>${ns + '/base_link' if ns else 'base_link'}</child_frame_id>
      <tf_topic>/tf</tf_topic>
    </plugin>
  </gazebo>

</robot>
