<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- Mecanum wheel macro
       name: wheel identifier (lf, rf, lr, rr)
       x, y, z: position relative to base_link (m)
       Side (left/right) is inferred from y sign.
       Wheel radius: 0.05 m, width: 0.04 m
  -->
  <xacro:macro name="mecanum_wheel" params="name x y z">
    <xacro:property name="wh_r" value="0.05"/>
    <xacro:property name="wh_w" value="0.04"/>
    <xacro:property name="wh_mass" value="0.15"/>
    <!-- side: +1 for left (y>0), -1 for right (y<0) -->
    <xacro:property name="side" value="${1 if y > 0 else -1}"/>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} ${z}" rpy="${-1.5708 * side} 0 0"/>
      <!-- Left wheels (+side):   axis 0 0  1  →  spin +Z in child = +Y in parent (forward)
           Right wheels (-side): axis 0 0 -1  →  spin -Z in child = +Y in parent (forward) -->
      <axis xyz="0 0 ${side}"/>
      <limit effort="0.3" velocity="10.0"/>
      <dynamics damping="0.01" friction="0.001"/>
    </joint>

    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wh_r}" length="${wh_w}"/>
        </geometry>
        <material name="wheel_material">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${wh_r}" length="${wh_w}"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="${wh_mass}" length="${wh_w}" radius="${wh_r}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- Transmission block (URDF standard, no ros2_control runtime required) -->
    <transmission name="${name}_wheel_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}_wheel_joint">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_wheel_motor">
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

</robot>
