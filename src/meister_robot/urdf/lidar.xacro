<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gazebo="http://gazebo.apache.org/xmlns/gazebo">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- 2D LiDAR macro
       name: frame link name
       x, y, z: position relative to parent (m)
       roll, pitch, yaw: orientation (rad)
       Parent is base_link by default.
       Sensor type: gpu_lidar, 360° horizontal, 10 Hz, 12 m range
  -->
  <xacro:macro name="lidar" params="name x y z roll pitch yaw">
    <joint name="${name}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} ${pitch} ${yaw}"/>
    </joint>

    <link name="${name}">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.05"/>
        </geometry>
        <material name="laser_material">
          <color rgba="0.13 0.13 0.13 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.05"/>
        </geometry>
      </collision>
      <xacro:inertial_cylinder mass="0.05" length="0.04" radius="0.05">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:inertial_cylinder>
    </link>

    <!-- Gazebo gpu_lidar sensor plugin -->
    <gazebo reference="${name}">
      <sensor name="${name}_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <topic>scan</topic>
        <gz_frame_id>${name}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.3</min>
            <max>12.0</max>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
