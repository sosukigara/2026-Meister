<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 認識モデルの入力は 320 なので、lite でも検出そのものは成立する。
       lite: 320x240 / 5 Hz。full: 640x480 / 10 Hz。 -->
  <xacro:arg name="sensor_profile" default="full"/>
  <xacro:property name="cam_lite" value="${'$(arg sensor_profile)' == 'lite'}"/>
  <xacro:property name="cam_width" value="${320 if cam_lite else 640}"/>
  <xacro:property name="cam_height" value="${240 if cam_lite else 480}"/>
  <xacro:property name="cam_rate" value="${5 if cam_lite else 10}"/>

  <!-- Camera Link (robot's-eye view, facing forward +X) -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.04"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 0.04"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="camera_link">
    <visual>
      <material>
        <ambient>0.5 0.5 0.5 1</ambient>
        <diffuse>0.75 0.75 0.75 1</diffuse>
        <specular>0.8 0.8 0.8 1</specular>
      </material>
    </visual>
  </gazebo>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.20 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Camera Sensor -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <topic>/camera_image</topic>
      <update_rate>${cam_rate}</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>${cam_width}</width>
          <height>${cam_height}</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
