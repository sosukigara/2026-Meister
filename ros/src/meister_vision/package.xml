<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>meister_vision</name>
  <version>0.1.0</version>
  <description>ONNX (YOLOv8n) による汎用物体検出の基盤パッケージ。画像トピックを購読し、検出結果(Detection2DArray)と描画済み画像を配信する。機能09(物体把持)のPC側検出基盤。</description>
  <maintainer email="s25089@tokyo.kosen-ac.jp">so</maintainer>
  <license>MIT</license>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>libopencv-dev</depend>
  <depend>onnxruntime_vendor</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>